# KClaw isolated Docker runtime example.
# Copy to .env only inside /home/edwin/workspace/kclaw when validating KClaw.
# Do not point these paths at the live MyClaw runtime until cutover.

OPENCLAW_IMAGE=kclaw:local
OPENCLAW_CONFIG_DIR=/home/edwin/workspace/kclaw/.runtime/openclaw
OPENCLAW_WORKSPACE_DIR=/home/edwin/workspace/kclaw/.runtime/openclaw/workspace
OPENCLAW_GATEWAY_PORT=18889
OPENCLAW_BRIDGE_PORT=18890
OPENCLAW_MSTEAMS_PORT=3979
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_TZ=Asia/Shanghai

# Set a validation-only token before starting the gateway.
OPENCLAW_GATEWAY_TOKEN=

# Optional: browser CDP proxy override used by the migrated docker-compose.override.yml.
OPENCLAW_CDP_PROXY_LISTEN_HOST=127.0.0.1
OPENCLAW_CDP_PROXY_LISTEN_PORT=9223
OPENCLAW_CDP_PROXY_TARGET_HOST=host.docker.internal
OPENCLAW_CDP_PROXY_TARGET_PORT=9222
