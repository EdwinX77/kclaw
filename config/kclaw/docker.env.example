# KClaw isolated Docker runtime example.
# Copy to .env only inside /home/edwin/workspace/kclaw when validating KClaw.
# Do not point these paths at the live MyClaw runtime until cutover.

OPENCLAW_IMAGE=kclaw:local
OPENCLAW_CONFIG_DIR=/home/edwin/workspace/kclaw/.runtime/openclaw
OPENCLAW_WORKSPACE_DIR=/home/edwin/workspace/kclaw/.runtime/openclaw/workspace
# Mount the KClaw source checkout into the kclaw-dev agent workspace so Codex
# harness work can edit/test this repo instead of an empty runtime directory.
KCLAW_DEV_WORKSPACE_DIR=/home/edwin/workspace/kclaw
OPENCLAW_GATEWAY_PORT=18889
OPENCLAW_BRIDGE_PORT=18890
OPENCLAW_MSTEAMS_PORT=3979
OPENCLAW_GATEWAY_BIND=lan
# Used only inside the openclaw-cli sidecar. Keep this on the gateway
# container port even when OPENCLAW_GATEWAY_PORT publishes another host port.
OPENCLAW_CLI_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_TZ=Asia/Shanghai

# China mainland build mirrors. Keep Corepack separate from pnpm install
# because Corepack requests package-manager versions such as /pnpm/11.2.2.
OPENCLAW_COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
OPENCLAW_NPM_REGISTRY=https://registry.npmmirror.com
OPENCLAW_APT_MIRROR=http://mirrors.ustc.edu.cn/debian
OPENCLAW_APT_SECURITY_MIRROR=http://mirrors.ustc.edu.cn/debian-security
OPENCLAW_PNPM_NETWORK_CONCURRENCY=1
OPENCLAW_PNPM_CHILD_CONCURRENCY=1
OPENCLAW_PNPM_FETCH_TIMEOUT=600000
OPENCLAW_PNPM_FETCH_RETRIES=8
OPENCLAW_PNPM_FETCH_RETRY_MINTIMEOUT=10000
OPENCLAW_PNPM_FETCH_RETRY_MAXTIMEOUT=120000
OPENCLAW_DOCKER_BUILD_HTTP_PROXY=
OPENCLAW_DOCKER_BUILD_HTTPS_PROXY=
OPENCLAW_DOCKER_BUILD_ALL_PROXY=
OPENCLAW_DOCKER_BUILD_NO_PROXY=localhost,127.0.0.1,::1,host.docker.internal,openclaw-gateway,openclaw-cli,mirrors.ustc.edu.cn,npmreg.proxy.ustclug.org,registry.npmmirror.com

# Runtime outbound proxy for started containers. Leave blank unless the
# container can reach the proxy endpoint directly.
OPENCLAW_RUNTIME_HTTP_PROXY=
OPENCLAW_RUNTIME_HTTPS_PROXY=
OPENCLAW_RUNTIME_ALL_PROXY=
OPENCLAW_RUNTIME_NO_PROXY=localhost,127.0.0.1,::1,host.docker.internal,openclaw-gateway,openclaw-cli

# Set a validation-only token before starting the gateway.
OPENCLAW_GATEWAY_TOKEN=

# Optional: browser CDP proxy override used by the migrated docker-compose.override.yml.
OPENCLAW_CDP_PROXY_LISTEN_HOST=127.0.0.1
OPENCLAW_CDP_PROXY_LISTEN_PORT=9223
OPENCLAW_CDP_PROXY_TARGET_HOST=host.docker.internal
OPENCLAW_CDP_PROXY_TARGET_PORT=9222
